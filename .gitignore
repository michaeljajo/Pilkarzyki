# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/node_modules.nosync
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# iCloud duplicate dirs/files (e.g. ".next 2", "node_modules 3", "*.icloud")
# iCloud appends " <n>" to conflicted copies, which escapes the rules above.
# No trailing slash: iCloud also produces SYMLINKS ("node_modules 2" ->
# node_modules.nosync), and a trailing slash matches directories only — which
# is how "node_modules 2" ended up tracked in git in the first place.
/.next *
/node_modules *
*.icloud

# local-only tooling: the squad scraper runs on this machine and its output is
# uploaded into the app by hand, so neither the script nor its data belongs here
/squad-scraper/

# dev server runtime state
/.dev-server/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI cache
supabase/.temp/

# Claude Code local state: launch.json (dev-server config), settings.local.json
# (per-machine permissions), scheduled-task locks and worktrees. All local to a
# checkout, none of it shared.
.claude/

# Point-in-time draft backups (scripts/backup-draft.js) — local snapshots, not source.
/draft-backups/
